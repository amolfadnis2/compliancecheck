/**
 * COMPLETE WORKING EXAMPLE - POSH Assessment with Category Breakdown
 * 
 * This is a complete, working example showing exactly how to integrate
 * the category breakdown display into your POSH assessment page.
 * 
 * File: src/app/assessment/posh/page.tsx
 */

'use client';

import React, { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { Info } from 'lucide-react';
import { 
  POSHQuestion, 
  POSHCategory,
  POSH_QUESTIONS, // Your main questions array
  POSH_CATEGORIES 
} from '@/lib/assessments/posh-compliance-questions';

// ============================================================================
// UTILITY: Calculate Category Breakdown
// ============================================================================

function calculateCategoryBreakdown(
  filteredQuestions: POSHQuestion[]
): Record<POSHCategory, number> {
  const breakdown: Record<POSHCategory, number> = {
    icc_constitution: 0,
    policy_documentation: 0,
    training_awareness: 0,
    display_communication: 0,
    reporting_monitoring: 0,
    complaint_handling: 0,
  };
  
  filteredQuestions.forEach(q => breakdown[q.category]++);
  return breakdown;
}

// ============================================================================
// COMPONENT: Category Breakdown Display
// ============================================================================

const CATEGORY_ICONS = {
  icc_constitution: '👥',
  policy_documentation: '📋',
  training_awareness: '🎓',
  display_communication: '📢',
  reporting_monitoring: '📊',
  complaint_handling: '⚖️',
};

interface CategoryBreakdownProps {
  totalQuestions: number;
  categoryBreakdown: Record<POSHCategory, number>;
}

function CategoryBreakdownDisplay({ 
  totalQuestions, 
  categoryBreakdown 
}: CategoryBreakdownProps) {
  const activeCategories = (Object.entries(categoryBreakdown) as [POSHCategory, number][])
    .filter(([_, count]) => count > 0);

  return (
    <div className="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6">
      <div className="flex items-start gap-3 mb-4">
        <Info className="h-6 w-6 text-blue-600 flex-shrink-0 mt-0.5" />
        <div className="flex-1">
          <h3 className="text-lg font-semibold text-gray-900 mb-2">
            Your Personalised Assessment: {totalQuestions} Questions
          </h3>
          <p className="text-sm text-gray-700 mb-4">
            Based on your company profile, we've tailored the assessment 
            to show only relevant questions.
          </p>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
        {activeCategories.map(([category, count]) => {
          const categoryInfo = POSH_CATEGORIES[category];
          const icon = CATEGORY_ICONS[category];
          
          return (
            <div 
              key={category}
              className="flex items-center gap-2 bg-white rounded-md p-3 border border-gray-200"
            >
              <span className="text-2xl" role="img" aria-label={categoryInfo.name}>
                {icon}
              </span>
              <span className="text-sm text-gray-700 flex-1">
                {categoryInfo.name}:
              </span>
              <span className="font-semibold text-gray-900">{count}</span>
            </div>
          );
        })}
      </div>
    </div>
  );
}

// ============================================================================
// MAIN COMPONENT: POSH Assessment Page
// ============================================================================

export default function POSHAssessmentPage() {
  const router = useRouter();
  
  // State management
  const [currentStep, setCurrentStep] = useState(0);
  const [userDetails, setUserDetails] = useState({
    fullName: '',
    email: '',
    phone: '',
    companyName: '',
    employeeCount: '',
    primaryState: '',
    industry: '',
  });
  
  const [responses, setResponses] = useState<Record<string, string>>({});
  const [filteredQuestions, setFilteredQuestions] = useState<POSHQuestion[]>([]);
  const [categoryBreakdown, setCategoryBreakdown] = useState<Record<POSHCategory, number>>({});
  const [totalQuestions, setTotalQuestions] = useState(0);
  
  // Filter questions based on user profile
  useEffect(() => {
    if (userDetails.employeeCount && userDetails.industry) {
      // Your filtering logic here
      const filtered = filterQuestionsForUser(POSH_QUESTIONS, userDetails);
      setFilteredQuestions(filtered);
      
      // Calculate category breakdown
      const breakdown = calculateCategoryBreakdown(filtered);
      setCategoryBreakdown(breakdown);
      setTotalQuestions(filtered.length);
    }
  }, [userDetails]);
  
  // Handle user input
  const handleStartAssessment = () => {
    if (validateUserDetails(userDetails)) {
      setCurrentStep(1); // Move to summary screen
    }
  };
  
  // ========================================================================
  // STEP 0: Company Details Form
  // ========================================================================
  
  if (currentStep === 0) {
    return (
      <div className="max-w-2xl mx-auto p-6">
        <div className="bg-white rounded-lg shadow-lg p-8">
          <div className="flex items-center gap-3 mb-6">
            <div className="bg-blue-100 rounded-lg p-3">
              <Info className="h-6 w-6 text-blue-700" />
            </div>
            <div>
              <h2 className="text-2xl font-bold text-gray-900">Company Details</h2>
              <p className="text-gray-600 text-sm">
                Tell us about your organization to personalize the assessment
              </p>
            </div>
          </div>

          {/* Form fields */}
          <div className="space-y-4">
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                Full Name *
              </label>
              <input
                type="text"
                value={userDetails.fullName}
                onChange={(e) => setUserDetails({...userDetails, fullName: e.target.value})}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                placeholder="John Doe"
              />
            </div>

            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                Email *
              </label>
              <input
                type="email"
                value={userDetails.email}
                onChange={(e) => setUserDetails({...userDetails, email: e.target.value})}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                placeholder="john@company.com"
              />
            </div>

            {/* Add more fields: phone, companyName, employeeCount, primaryState, industry */}

            <button
              onClick={handleStartAssessment}
              className="w-full bg-blue-700 hover:bg-blue-800 text-white py-3 px-6 rounded-lg font-semibold mt-6"
            >
              Start Assessment
            </button>
          </div>
        </div>
      </div>
    );
  }
  
  // ========================================================================
  // STEP 1: Category Breakdown Summary (NEW!)
  // ========================================================================
  
  if (currentStep === 1) {
    return (
      <div className="max-w-3xl mx-auto p-6">
        <div className="mb-8">
          <h1 className="text-3xl font-bold text-gray-900 mb-2">
            POSH Compliance Audit
          </h1>
          <p className="text-gray-600">
            Your personalized compliance assessment is ready
          </p>
        </div>

        {/* 🎯 THIS IS THE KEY ADDITION */}
        <CategoryBreakdownDisplay 
          totalQuestions={totalQuestions}
          categoryBreakdown={categoryBreakdown}
        />

        <div className="flex gap-4 mt-6">
          <button
            onClick={() => setCurrentStep(0)}
            className="px-6 py-3 border border-gray-300 rounded-lg hover:bg-gray-50"
          >
            ← Back
          </button>
          <button
            onClick={() => setCurrentStep(2)}
            className="flex-1 bg-blue-700 hover:bg-blue-800 text-white py-3 px-6 rounded-lg font-semibold"
          >
            Begin Assessment →
          </button>
        </div>
      </div>
    );
  }
  
  // ========================================================================
  // STEP 2+: Questions (adjusted index for new step)
  // ========================================================================
  
  const questionIndex = currentStep - 2;
  const currentQuestion = filteredQuestions[questionIndex];
  
  if (!currentQuestion) {
    // All questions completed
    router.push('/results/[id]');
    return null;
  }
  
  return (
    <div className="max-w-2xl mx-auto p-6">
      {/* Progress bar */}
      <div className="mb-6">
        <div className="flex justify-between text-sm text-gray-600 mb-2">
          <span>{POSH_CATEGORIES[currentQuestion.category].name}</span>
          <span>Question {questionIndex + 1} of {totalQuestions}</span>
        </div>
        <div className="w-full bg-gray-200 rounded-full h-2">
          <div 
            className="bg-blue-600 h-2 rounded-full transition-all"
            style={{ width: `${((questionIndex + 1) / totalQuestions) * 100}%` }}
            aria-label="Assessment progress"
          />
        </div>
      </div>

      {/* Question display */}
      <div className="bg-white rounded-lg shadow-lg p-8">
        <h2 className="text-xl font-semibold text-gray-900 mb-6">
          {currentQuestion.text}
        </h2>

        {/* Answer buttons (yes/no or multiple choice) */}
        <div className="space-y-3">
          {currentQuestion.options?.map((option) => (
            <button
              key={option.value}
              onClick={() => handleAnswer(currentQuestion.id, option.value)}
              className="w-full text-left px-6 py-4 border-2 border-gray-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition-all"
            >
              {option.label}
            </button>
          ))}
        </div>

        {/* Help text */}
        {currentQuestion.helpText && (
          <p className="mt-4 text-sm text-gray-600 italic">
            ℹ️ {currentQuestion.helpText}
          </p>
        )}
      </div>
    </div>
  );
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

function filterQuestionsForUser(
  allQuestions: POSHQuestion[],
  userProfile: any
): POSHQuestion[] {
  // Your filtering logic
  return allQuestions.filter(q => {
    // Example filtering
    if (q.applicabilityCode === 'MULTI_LOCATION') {
      return userProfile.locationCount !== 'single';
    }
    return true;
  });
}

function validateUserDetails(details: any): boolean {
  return !!(details.fullName && details.email && details.companyName);
}

function handleAnswer(questionId: string, answer: string) {
  // Your answer handling logic
}
