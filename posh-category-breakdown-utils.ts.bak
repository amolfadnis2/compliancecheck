/**
 * POSH Assessment - Category Breakdown Calculator
 * 
 * Add this to your posh-compliance-questions.ts file or import where needed
 */

import { POSHQuestion, POSHCategory, POSH_CATEGORIES } from './posh-compliance-questions';

/**
 * Calculate question counts per category after filtering
 * Returns object with category codes and their filtered question counts
 */
export function calculateCategoryBreakdown(
  filteredQuestions: POSHQuestion[]
): Record<POSHCategory, number> {
  const breakdown: Record<POSHCategory, number> = {
    icc_constitution: 0,
    policy_documentation: 0,
    training_awareness: 0,
    display_communication: 0,
    reporting_monitoring: 0,
    complaint_handling: 0,
  };
  
  filteredQuestions.forEach(q => {
    breakdown[q.category]++;
  });
  
  return breakdown;
}

