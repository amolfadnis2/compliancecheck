# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=ComplianceCheck <noreply@compliancecheck.co.in>

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Newsletter broadcast
# Generate a long random secret, e.g.: openssl rand -hex 32
# Add the same value as NEWSLETTER_BROADCAST_SECRET in GitHub repository secrets.
NEWSLETTER_BROADCAST_SECRET=your-strong-random-secret-here
