/**
 * POSH Assessment Category Breakdown Component
 * 
 * Shows personalized assessment summary with category-wise question counts
 * Display AFTER applicability questions, BEFORE main assessment starts
 */

import React from 'react';
import { Info } from 'lucide-react';
import { POSHCategory } from '@/lib/assessments/posh-compliance-questions';
import { CATEGORY_DISPLAY_INFO } from '@/lib/assessments/posh-category-breakdown-utils';

interface CategoryBreakdownProps {
  totalQuestions: number;
  categoryBreakdown: Record<POSHCategory, number>;
}

export function POSHCategoryBreakdown({ 
  totalQuestions, 
  categoryBreakdown 
}: CategoryBreakdownProps) {
  // Filter out categories with 0 questions
  const activeCategories = (Object.entries(categoryBreakdown) as [POSHCategory, number][])
    .filter(([_, count]) => count > 0);

  return (
    <div className="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6">
      <div className="flex items-start gap-3 mb-4">
        <Info className="h-6 w-6 text-blue-600 flex-shrink-0 mt-0.5" />
        <div className="flex-1">
          <h3 className="text-lg font-semibold text-gray-900 mb-2">
            Your Personalised Assessment: {totalQuestions} Questions
          </h3>
          <p className="text-sm text-gray-700 mb-4">
            Based on your data processing profile, we've tailored the assessment 
            to show only relevant questions.
          </p>
        </div>
      </div>

      {/* Category Grid - 2 columns */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
        {activeCategories.map(([category, count]) => {
          const displayInfo = CATEGORY_DISPLAY_INFO[category];
          
          return (
            <div 
              key={category}
              className="flex items-center gap-2 bg-white rounded-md p-3 border border-gray-200"
            >
              <span className="text-2xl" role="img" aria-label={displayInfo.label}>
                {displayInfo.icon}
              </span>
              <span className="text-sm text-gray-700 flex-1">
                {displayInfo.label}:
              </span>
              <span className="font-semibold text-gray-900">
                {count}
              </span>
            </div>
          );
        })}
      </div>
    </div>
  );
}
